
# =============================================================================
# TUTBOT — Frontend environment variables
# -----------------------------------------------------------------------------
# Copy this file to `.env` (or `.env.local`) and fill in your values.
# Vite only exposes variables prefixed with `VITE_` to the browser.
# =============================================================================

# Base URL of the Laravel API (no trailing slash).
# Example: http://localhost:8000/api  (local Laravel artisan serve)
# Example: https://api.tutbot.com/api (production)
VITE_API_URL=http://localhost:8000/api

# Optional: separate URL for the AI chat endpoint, if you front it through a
# different gateway than the main API. Defaults to ${VITE_API_URL}/ai/chat when
# unset.
# VITE_AI_CHAT_URL=

# Optional: feature flags
# VITE_FEATURE_VIRTUAL_TOURS=true
